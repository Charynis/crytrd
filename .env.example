# Copy to .env (git-ignored) and fill in. Never commit .env.
# Freqtrade maps FREQTRADE__SECTION__KEY onto config.json values.

# Discord: Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
FREQTRADE__DISCORD__ENABLED=true
FREQTRADE__DISCORD__WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# FreqUI login (http://localhost:8080). Use long random strings.
FREQTRADE__API_SERVER__USERNAME=crytrd
FREQTRADE__API_SERVER__PASSWORD=change-me
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-me-to-a-long-random-string
FREQTRADE__API_SERVER__WS_TOKEN=change-me-too
